# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg://osint:osint@localhost:5432/osint

# CORS origins for the frontend dev server
CORS_ORIGINS=http://localhost:5173

# OFAC SDN legacy XML feed (public, no auth). Override to pin a local snapshot.
OFAC_SDN_URL=https://sanctionslistservice.ofac.treas.gov/api/download/sdn.xml

# Area of interest for spatial sources: lat_min,lon_min,lat_max,lon_max (Cuba).
AOI_BBOX=19.0,-85.5,24.0,-73.5

# ADS-B (OpenSky) — anonymous access, no key needed.
OPENSKY_URL=https://opensky-network.org/api/states/all

# AIS (AISStream.io) — get a free key at https://aisstream.io, then set it here.
AISSTREAM_API_KEY=
AIS_SAMPLE_SECONDS=60
